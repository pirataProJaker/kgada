[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
windows.debug.x86_64 = "res://rust_core/target/debug/rust_core.dll"
windows.release.x86_64 = "res://rust_core/target/release/rust_core.dll"
linux.debug.x86_64 = "res://rust_core/target/debug/librust_core.so"
linux.release.x86_64 = "res://rust_core/target/release/librust_core.so"
macos.debug = "res://rust_core/target/debug/librust_core.dylib"
macos.release = "res://rust_core/target/release/librust_core.dylib"
macos.debug.arm64 = "res://rust_core/target/debug/librust_core.dylib"
macos.release.arm64 = "res://rust_core/target/release/librust_core.dylib"
